# France Political Intelligence - Environment Configuration
# Copy this file to .env and fill in values

# AI Provider Configuration (default: none - fully deterministic mode)
# Options: none, gemini, groq, openrouter
AI_PROVIDER=none

# AI Provider API Keys (only needed if AI_PROVIDER is not "none")
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model Names (defaults shown)
# GEMINI_MODEL=gemini-1.5-flash-latest
# GROQ_MODEL=llama-3.1-8b-instant
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# Backend Configuration
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/france_intel.db

# Frontend Configuration (set in frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Data Privacy: Which data leaves this machine
# - RSS article titles/URLs are fetched from public feeds
# - If AI_PROVIDER != none: article text is sent to the AI provider
# - Portfolio data is NEVER sent to AI providers
# - No user data is sent to external services by default

# Optional: RSS refresh interval (seconds, default 3600)
RSS_REFRESH_INTERVAL=3600

# Demo mode (always show SYNTHETIC DATA labels)
DEMO_MODE=true
